# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Frontend (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Orchestrator (signs on-chain ops: escrow release, task registration)
ORCHESTRATOR_SECRET_KEY=S...your_secret_here...

# Contract Addresses (Testnet)
TOOL_REGISTRY_CONTRACT_ID=CARJRAXMYOM7TNNCR2K4OVZTO6BYUTUIW5AB2ZHDSF5UZXBSWU7YZQBW
COMPLIANCE_CONTRACT_ID=CA6CNNWPEP7CIOQA2YOQ425O6BVU6JUVY4375MBCO6D4FRXGN2ZCPHD2
REP_ASSET_CONTRACT=CDJCWXFHMO3QSZJNP6ZPQKOB4Z6EC6R5SBOOBJ5ULIWPW4FYD4N2KTVY
REP_ASSET_ISSUER=GDABMVSW6QMLZAPOUUW4ZSXN4WLPHAHXFDMTG3FDKMBVXHH6FDHJZ7ON

# x402 Payment Protocol
X402_ENABLED=true
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=stellar:testnet
X402_USDC_ADDRESS=CDUQPQI6SCMDBWK4ZKBMJGMGSJHHO5ARKDW45M7GJSEFNC44RUPD2WJQ
X402_ESCROW_CONTRACT=CAMPNA3TNE23UYM5WSTXHQWA5HGU7HL6M2T64R5VNQT5PJS6UBIXOCCO

# Budget Billing
BUDGET_MARGIN=1.5

# Services
MCP_META_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:5050

# Hebbian Embedding Provider (qwen3 | sentence | none)
HEBBIAN_EMBEDDING_PROVIDER=qwen3
LMSTUDIO_BASE_URL=http://localhost:1234/v1
QWEN3_EMBED_MODEL=qwen3-embedding-0.6b
# QWEN3_DIMENSIONS=768  # Leave unset for full 1024-dim; set to 768 to skip re-embedding
QWEN3_INDEX_INSTRUCTION=Represent this agent task outcome for memory storage:
QWEN3_QUERY_INSTRUCTION=Retrieve memory relevant to this agent task:

# --- Refund sweeper tuning ---
# Outer cycle caps refunds attempted per 60s loop iteration. Prevents a
# flood of expirations from draining the orchestrator's XLM in one go.
REFUND_SWEEPER_MAX_PER_CYCLE=10
# Tasks marked as recently-attempted are skipped for this many seconds before
# becoming eligible again. Prevents tight-loop retries on a stuck refund.
REFUND_SWEEPER_RETRY_INTERVAL_SECONDS=600

# --- Stellar health probe ---
# Threshold (in XLM) below which /health/stellar reports low_balance=true.
# Tune higher on mainnet to leave headroom for TTL extension + fee bumps.
STELLAR_LOW_BALANCE_XLM=10

# --- mcp-meta auth posture (defaults match production / strict) ---
# REQUIRE_CLIENT_ID=false skips the JWT audience check (more permissive).
REQUIRE_CLIENT_ID=true
# Per-second rate limits per tier. Defaults: ~50/hr free, ~500/hr paid.
RATE_LIMIT_FREE=0.014
RATE_LIMIT_PAID=0.14

# --- Orchestrator signing mode ---
# "single" (default): orchestrator hot key signs and submits in one shot.
# "external": refuse auto-signing; callers must use build_unsigned_*
# helpers + co-sign off-line + submit_signed_xdr (multisig path).
ORCHESTRATOR_SIGNING_MODE=single
