# Documentation — only the top-level README.md is tracked. Inner READMEs,
# audit/ + docs/ contents, contracts/DEPLOYMENTS.md, etc., stay local.
*.md
!/README.md

# ...except the files whose whole purpose is to be read by somebody outside
# this machine. These are deliverables, not notes:
#   VERIFICATION.md  — the test results, regenerated by `make verify`. A report
#                      a reviewer cannot open is not evidence of anything.
#   evidence/        — on-chain snapshots kept because testnet resets delete
#                      contract data and redeploys move history to a new ID.
!/VERIFICATION.md
!/evidence/
!/evidence/**/
!/evidence/**/*.md

# Full directory excludes — entire audit/ + docs/ trees stay local
# (covers non-markdown files too, e.g. images, drafts, sub-runbooks)
audit/
docs/
**/docs/

# Database dumps never go in the repository. They carry wallet addresses, the
# text of hired tasks and the payment history of a real database. Kept in
# ../agentbrujula-backups/ instead — see its LEEME.md.
evidence/backups/
*.sql
!contracts/**/*.sql

# Backups locales de scripts
*.bak

# Evidencia de las auditorías: informes y 10 MB de capturas. Se quedan
# en el disco. Una vez dentro del historial no salen sin reescribirlo.
evidence/
