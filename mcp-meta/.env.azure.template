# MCP-Meta Azure Environment Variables

# Auth (at least one required for production)
AUTH_ENABLED=true
AUTH_FREE_KEY=mcp-free-CHANGE-ME
AUTH_PAID_KEY=mcp-paid-CHANGE-ME

# Keycloak (optional, for OAuth2 login)
# KEYCLOAK_URL=https://keycloak.yourdomain.com
# KEYCLOAK_REALM=mcp-meta
# KEYCLOAK_CLIENT_ID=mcp-meta-web

# LLM (agents use this for reasoning)
OPENROUTER_API_KEY=sk-or-v1-CHANGE-ME

# Search fallback
TAVILY_API_KEY=tvly-CHANGE-ME

# Embedding (for intent classification)
# In Azure: deploy a text-embedding model as sidecar
EMBEDDING_URL=http://localhost:1234/v1

# Kurai search (if deploying kurai alongside)
# KURAI_URL=http://kurai:8080
