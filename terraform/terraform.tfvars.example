# Copy to prod.tfvars (gitignored) and fill in.
subscription_id    = "00000000-0000-0000-0000-000000000000"
tenant_id          = "00000000-0000-0000-0000-000000000000"
operator_object_id = "00000000-0000-0000-0000-000000000000"  # az ad signed-in-user show --query id -o tsv

location    = "mexicocentral"  # or "eastus2" if a SKU is missing in MX
environment = "prod"

# Front Door custom domain. Leave empty to skip custom domain binding
# (you'll get *.azurefd.net only).
custom_domain = "api.agentcanonical.com"

# Vercel URLs that may call the api via CORS. Replace with real Vercel
# project URLs after the Vercel project is set up.
vercel_origin_patterns = [
  "https://agentcanonical.com",
  "https://www.agentcanonical.com",
]

# Stellar — testnet defaults; flip when mainnet contract deploy lands.
stellar_network     = "testnet"
stellar_rpc_url     = "https://soroban-testnet.stellar.org"
stellar_horizon_url = "https://horizon-testnet.stellar.org"

# Image tags — MUST be immutable (git SHA) when environment="prod".
# Terraform validation rejects "latest" for prod. For first deploy,
# push images manually then paste the SHA here.
api_image_tag      = "<git-sha>"
mcp_meta_image_tag = "<git-sha>"

# Key Vault network ACL.
# Empty list = vault is publicly reachable (you can `az keyvault secret set`
# from anywhere). Populate with your operator IP(s) to flip the vault to
# default_action=Deny. Container Apps still reach it via managed identity
# (bypass=AzureServices). To find your IP: curl -s https://api.ipify.org
# keyvault_allowed_ip_ranges = ["198.51.100.5/32"]
keyvault_allowed_ip_ranges = []
